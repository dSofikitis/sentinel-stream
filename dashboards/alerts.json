      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "format": 0,
          "rawSql": "SELECT count() FROM sentinel.alerts WHERE ts > now() - INTERVAL 24 HOUR AND severity IN ('high', 'critical')"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alerts per minute by kind",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "sentinel-clickhouse" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "rawSql": "SELECT toStartOfMinute(ts) AS t, kind, count() AS c FROM sentinel.alerts WHERE ts >= $__fromTime AND ts <= $__toTime GROUP BY t, kind ORDER BY t"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top firing rules (24h)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "sentinel-clickhouse" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "format": 2,
          "rawSql": "SELECT rule_id, rule_title, severity, count() AS fires FROM sentinel.alerts WHERE kind = 'sigma' AND ts > now() - INTERVAL 24 HOUR GROUP BY rule_id, rule_title, severity ORDER BY fires DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent 50 alerts",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "sentinel-clickhouse" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "format": 2,
          "rawSql": "SELECT ts, severity, kind, COALESCE(rule_id, model) AS detector, message, event_id FROM sentinel.alerts ORDER BY ts DESC LIMIT 50"
        }
      ]
    }
