      "targets": [
        {
          "refId": "A",
          "format": 2,
          "rawSql": "SELECT kind, count() AS c FROM sentinel.alerts WHERE ts > now() - INTERVAL 24 HOUR GROUP BY kind"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Distinct firing rules (24h)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "sentinel-clickhouse" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "format": 0,
          "rawSql": "SELECT uniqExact(rule_id) FROM sentinel.alerts WHERE kind = 'sigma' AND ts > now() - INTERVAL 24 HOUR"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "High/critical (24h)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "sentinel-clickhouse" },
